<script>
const $=id=>document.getElementById(id);
let rootHandle=null, allFiles=[], songs=[], selected=null, queue=[], cur="", keyShift=0, tempo=1, bgvURL=null, sf2File=null, lyricsText="", lyricsLines=[], lyricTimer=null, midiPlayer=null, bgvOn=true;
const supportedDir=!!window.showDirectoryPicker;
function setStatus(s){$('status').textContent=s}
function ext(name){return (name.split('.').pop()||'').toLowerCase()}
function cleanTitle(name){return name.replace(/\.(mid|midi|kar)$/i,'').replace(/[_-]+/g,' ').trim()}
function metaFromName(file,path){let title=cleanTitle(file.name),num=null,artist='Unknown',genre='Local',m=title.match(/^(\d{1,5})\s*[-._ ]\s*(.*)$/);if(m){num=Number(m[1]);title=m[2]}return {num,title,artist,genre,type:'.'+ext(file.name),path,file,handle:null}}
async function walk(dir,path=''){for await(const entry of dir.values()){const p=path?path+'/'+entry.name:entry.name;if(entry.kind==='directory'){await walk(entry,p)}else{const file=await entry.getFile();allFiles.push({name:entry.name,path:p,file,handle:entry})}}}
function findFileByExt(f){return ['mid','midi','kar'].includes(ext(f.name))}
function assignSongs(){const old=new Map(songs.map(s=>[s.path,s.num]));songs=allFiles.filter(findFileByExt).map((f,i)=>{const s=metaFromName(f.file,f.path);s.handle=f.handle;s.num=old.get(f.path)||s.num||1001+i;return s}).sort((a,b)=>a.num-b.num||a.title.localeCompare(b.title));renderList();setStatus(`${songs.length} MIDI/KAR files • ${allFiles.filter(x=>ext(x.name)==='mp4'||ext(x.name)==='webm').length} videos found.`)}
async function scanFolder(){if(!supportedDir){alert('Folder scan is not supported in this browser. Use Chrome on Android with directory picker support, or Add files to select files manually.');return}try{rootHandle=await window.showDirectoryPicker({mode:'readwrite'});allFiles=[];await walk(rootHandle);assignSongs();const vid=allFiles.find(x=>['mp4','webm'].includes(ext(x.name))&&/bgv|background/i.test(x.path))||allFiles.find(x=>['mp4','webm'].includes(ext(x.name)));if(vid)useBgv(vid.file);const sf=allFiles.find(x=>ext(x.name)==='sf2');if(sf){$('sf2Status').textContent='SF2 found: '+sf.path+' (not yet connected to a synth engine).'} }catch(e){if(e.name!=='AbortError')alert('Could not scan folder: '+e.message)}}
function renderList(){const q=$('search').value.toLowerCase();$('list').innerHTML='';songs.filter(s=>(`${s.num} ${s.title} ${s.artist} ${s.path}`).toLowerCase().includes(q)).forEach(s=>{const d=document.createElement('div');d.className='song'+(selected===s?' active':'');d.innerHTML=`<span><b>${s.num}</b> · ${escapeHtml(s.title)}<div class="small">${escapeHtml(s.path)}</div></span><span>＋</span>`;d.onclick=e=>{selectSong(s);if(e.target.closest('span:last-child'))addQueue(s)};$('list').appendChild(d)});if(!songs.length)$('list').innerHTML='<div class="small">No .mid/.midi/.kar files found yet. Choose the main KaraokePro folder.</div>'}
function escapeHtml(s){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function selectSong(s){selected=s;cur=String(s.num);$('disp').textContent=cur.padEnd(4,'_');$('preview').innerHTML=`<b class="neon">${s.num} — ${escapeHtml(s.title)}</b><div>${escapeHtml(s.path)}</div>`;renderList()}
function press(n){if(cur.length>=5)return;cur+=n;$('disp').textContent=cur.padEnd(4,'_');const s=songs.find(x=>String(x.num)===cur);if(s)selectSong(s);else $('preview').textContent='Looking for song number '+cur}
function enterNum(){const s=songs.find(x=>String(x.num)===cur);if(s){selectSong(s);playSong(s)}else alert('Song number not found. Scan your folder or check the song number.')}
function addQueue(s){queue.push(s);renderQueue()}
function renderQueue(){$('queue').innerHTML='';queue.forEach((s,i)=>{const d=document.createElement('div');d.className='song';d.innerHTML=`<span>${i+1}. ${escapeHtml(s.title)}</span><button>Play</button>`;d.querySelector('button').onclick=()=>{queue.splice(i,1);renderQueue();playSong(s)};$('queue').appendChild(d)});$('qCount').textContent=queue.length+' queued'}
function clearQueue(){queue=[];renderQueue()}
async function loadScript(src){return new Promise((resolve,reject)=>{const s=document.createElement('script');s.src=src;s.onload=resolve;s.onerror=()=>reject(new Error('Could not load '+src));document.head.appendChild(s)})}
async function ensureMidi(){if(midiPlayer)return true;try{if(!window.MidiPlayer||!window.MidiPlayer.Player)await loadScript('https://cdn.jsdelivr.net/npm/midi-player-js@2.0.16/build/MidiPlayer.min.js');if(!window.MidiPlayer||!window.MidiPlayer.Player)throw Error('MIDI player library unavailable');midiPlayer=new MidiPlayer.Player(event=>{if(event.name==='Note on'){} });midiPlayer.on('endOfFile',()=>{$('playState').textContent='MIDI finished.';if(queue.length)playSong(queue.shift())});return true}catch(e){$('playState').textContent='MIDI engine unavailable: '+e.message;alert('MIDI playback engine could not load. Check internet access. For dependable SF2 audio, use a dedicated synth integration or native app.');return false}}
async function playSong(s){if(!s)return;selected=s;renderList();$('nowPlay').textContent=s.num+' — '+s.title;$('singNum').textContent=s.num;$('singTitle').textContent=s.title;try{const ok=await ensureMidi();if(!ok)return;const data=await s.file.arrayBuffer();midiPlayer.stop();midiPlayer.loadArrayBuffer(data);midiPlayer.setTempo(tempo*100);midiPlayer.play();$('playState').textContent='Playing MIDI (browser synth; SF2 not guaranteed).';$('singHint').textContent='MIDI playback active';$('lyr1').textContent=s.title; if(s.file.name.toLowerCase().endsWith('.kar')) $('lyr2').textContent='KAR selected. Embedded lyric rendering requires a lyric-capable MIDI/KAR parser.';}catch(e){alert('Could not play this MIDI/KAR file: '+e.message)}}
function stopSong(){if(midiPlayer)try{midiPlayer.stop()}catch(e){}$('playState').textContent='Playback stopped.';if(lyricTimer)clearInterval(lyricTimer)}
function useBgv(file){if(bgvURL)URL.revokeObjectURL(bgvURL);bgvURL=URL.createObjectURL(file);$('bgv').src=bgvURL;$('singBgv').src=bgvURL;if(bgvOn){$('bgv').play().catch(()=>{});$('singBgv').play().catch(()=>{})}}
function toggleBgv(){bgvOn=!bgvOn;[$('bgv'),$('singBgv')].forEach(v=>{v.muted=true;if(bgvOn)v.play().catch(()=>{});else v.pause()});$('toggleBgv').textContent=bgvOn?'BGV on/off (ON)':'BGV on/off (OFF)'}
function printPdf(){const w=window.open('','_blank');if(!w){alert('Allow pop-ups to print the songbook.');return}const rows=songs.map(s=>`<tr><td>${s.num}</td><td>${escapeHtml(s.title)}</td><td>${escapeHtml(s.artist)}</td><td>${escapeHtml(s.genre)}</td><td>${escapeHtml(s.type)}</td></tr>`).join('');w.document.write(`<!doctype html><html><head><title>kanta.acetoygwapo Songbook</title><style>body{font:12px Arial;padding:20px}h1{font-size:20px}table{border-collapse:collapse;width:100%}td,th{border:1px solid #888;padding:5px;text-align:left}th{background:#eee}</style></head><body><h1>kanta.acetoygwapo — Songbook</h1><p>${songs.length} songs</p><table><thead><tr><th>No.</th><th>Title</th><th>Artist</th><th>Genre</th><th>Type</th></tr></thead><tbody>${rows}</tbody></table><script>window.onload=()=>window.print()<\/script></body></html>`);w.document.close()}
async function exportIndex(){const data=songs.map(s=>`${s.num}\t${s.title}\t${s.artist}\t${s.genre}\t${s.type}\t${s.path}`).join('\n');if(rootHandle){try{const idx=await rootHandle.getDirectoryHandle('idx',{create:true});const h=await idx.getFileHandle('songs.idx',{create:true});const wr=await h.createWritable();await wr.write(data);await wr.close();alert('Saved idx/songs.idx in selected folder.')}catch(e){downloadText(data,'songs.idx')}}else downloadText(data,'songs.idx')}
function downloadText(data,name){const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([data],{type:'text/plain'}));a.download=name;a.click();setTimeout(()=>URL.revokeObjectURL(a.href),1000)}
function handleManualFiles(files){for(const file of files){allFiles.push({name:file.name,path:file.webkitRelativePath||file.name,file,handle:null})}assignSongs();const v=[...files].find(f=>['mp4','webm'].includes(ext(f.name)));if(v)useBgv(v);const sf=[...files].find(f=>ext(f.name)==='sf2');if(sf){sf2File=sf;$('sf2Status').textContent='Selected '+sf.name+'; requires a SoundFont-capable synthesizer to play with it.'}const lyr=[...files].find(f=>['txt','lrc'].includes(ext(f.name)));if(lyr)readLyrics(lyr)}
function readLyrics(file){const r=new FileReader();r.onload=()=>{lyricsText=String(r.result||'');lyricsLines=lyricsText.split(/\r?\n/).filter(Boolean);$('lyr2').textContent=lyricsLines.join('\n')||'No lyrics found.'};r.readAsText(file)}
$('pickFolder').onclick=scanFolder;$('pickFiles').onclick=()=>$('fileInput').click();$('fileInput').onchange=e=>handleManualFiles(e.target.files);$('search').oninput=renderList;
$('keys').innerHTML=['1','2','3','4','5','6','7','8','9','C','0','ENTER'].map(n=>`<button class="key ${n==='ENTER'?'enter':''}" data-k="${n}">${n}</button>`).join('');$('keys').onclick=e=>{const n=e.target.dataset.k;if(!n)return;if(n==='C'){cur='';$('disp').textContent='____';return}if(n==='ENTER'){enterNum();return}press(n)};
$('play').onclick=()=>selected?playSong(selected):enterNum();$('stop').onclick=stopSong;$('clearQ').onclick=clearQueue;$('playNext').onclick=()=>{if(queue.length)playSong(queue.shift());else alert('Queue is empty');renderQueue()};
$('keyUp').onclick=()=>{$('keyLabel').textContent='Key: '+(++keyShift)};$('keyDown').onclick=()=>{$('keyLabel').textContent='Key: '+(--keyShift)};$('tempoUp').onclick=()=>{tempo=Math.min(2,tempo+.1);$('tempoLabel').textContent=Math.round(tempo*100)+'%';if(midiPlayer)midiPlayer.setTempo(tempo*100)};$('tempoDown').onclick=()=>{tempo=Math.max(.5,tempo-.1);$('tempoLabel').textContent=Math.round(tempo*100)+'%';if(midiPlayer)midiPlayer.setTempo(tempo*100)};
$('pdf').onclick=printPdf;$('exportIndex').onclick=exportIndex;$('chooseBgv').onclick=()=>$('fileInput').click();$('toggleBgv').onclick=toggleBgv;$('chooseSf2').onclick=()=>$('fileInput').click();$('chooseLyrics').onclick=()=>$('fileInput').click();
$('showSing').onclick=()=>{$('singScreen').classList.add('show');if(selected){$('singNum').textContent=selected.num;$('singTitle').textContent=selected.title;$('lyr1').textContent=selected.title}};$('closeSing').onclick=()=>$('singScreen').classList.remove('show');$('singPlay').onclick=()=>selected&&playSong(selected);$('singStop').onclick=stopSong;
if(!supportedDir){$('pickFolder').textContent='📁 Folder scan unavailable';setStatus('Browser folder API unavailable. Use Add files or open in a supported Chrome-based browser.')}
</script></body></html>
package com.acetoy.kanta;

import android.app.Activity;
import android.os.Bundle;
import android.webkit.WebChromeClient;
import android.webkit.WebSettings;
import android.webkit.WebView;
import android.webkit.WebViewClient;
import android.webkit.ValueCallback;
import android.content.Intent;
import android.net.Uri;

public class MainActivity extends Activity {
    private WebView webView;
    private ValueCallback<Uri[]> fileCallback;
    private static final int FILE_CHOOSER_REQUEST = 1001;

    @Override public void onCreate(Bundle savedInstanceState) {
        super.onCreate(savedInstanceState);
        webView = new WebView(this);
        setContentView(webView);
        WebSettings settings = webView.getSettings();
        settings.setJavaScriptEnabled(true);
        settings.setDomStorageEnabled(true);
        settings.setAllowFileAccess(true);
        settings.setAllowContentAccess(true);
        settings.setMediaPlaybackRequiresUserGesture(false);
        settings.setSupportMultipleWindows(true);
        webView.setWebViewClient(new WebViewClient());
        webView.setWebChromeClient(new WebChromeClient() {
            @Override public boolean onShowFileChooser(WebView view, ValueCallback<Uri[]> callback, FileChooserParams params) {
                if (fileCallback != null) fileCallback.onReceiveValue(null);
                fileCallback = callback;
                Intent intent = params.createIntent();
                try { startActivityForResult(intent, FILE_CHOOSER_REQUEST); }
                catch (Exception e) { fileCallback = null; return false; }
                return true;
            }
        });
        webView.loadUrl("file:///android_asset/index.html");
    }

    @Override protected void onActivityResult(int requestCode, int resultCode, Intent data) {
        super.onActivityResult(requestCode, resultCode, data);
        if (requestCode == FILE_CHOOSER_REQUEST && fileCallback != null) {
            Uri[] result = WebChromeClient.FileChooserParams.parseResult(resultCode, data);
            fileCallback.onReceiveValue(result);
            fileCallback = null;
        }
    }

    @Override public void onBackPressed() {
        if (webView != null && webView.canGoBack()) webView.goBack();
        else super.onBackPressed();
    }
}

